PORT=3000
MONGO_URI=
OPENAI_API_KEY=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=

# Razorpay Payment Integration
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Public base URL of THIS backend (required in production - used as the Razorpay
# Payment Link callback_url for the WhatsApp UPGRADE flow; without it in prod,
# upgrade payment confirmations silently point at http://localhost:3001)
SERVER_URL=

# Redis Configuration (for Bull Queue)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
LESSON_WORKER_CONCURRENCY=15

# Admin/operational endpoint protection (required in production - see middleware/adminAuth.js)
# Send as header: x-admin-secret: <value>
ADMIN_SECRET=

# Meta WhatsApp webhook security (three DIFFERENT values):
# - META_APP_SECRET: App Secret of the Meta app (FluencyEnglish > App settings > Basic).
#   Used to verify X-Hub-Signature-256 on POST /api/webhook. Required - webhooks are rejected without it.
# - WHATSAPP_VERIFY_TOKEN: any string you choose, also entered in Meta's webhook config; used only for GET verification.
# - WHATSAPP_TOKEN: Graph API access token used to SEND messages.
META_APP_SECRET=

# Optional: approximate USD->INR rate for the AI Costs admin page (display only; USD is the source currency)
USD_TO_INR=

# FREE_PROMO (100% promo) welcome template: subscription_welcome (Utility, en_US).
# Leave EMPTY until Meta approves it - no welcome is sent until then. Do not use
# beta_welcome_free (reclassified as Marketing). Paid learners always get payment_welcome_new.
# Body params: {{1}} name, {{2}} plan days, {{3}} level, {{4}} expiry date (YYYY-MM-DD)
WHATSAPP_FREE_WELCOME_TEMPLATE=
WHATSAPP_FREE_WELCOME_TEMPLATE_LANG=en_US

# 7:00 AM learner-local daily lessons for non-India time zones (cron/internationalLessonScheduler.js).
# Keep false until production rollout is approved: everyone then stays on the 7:00 AM IST cron.
# Rollback = set false and restart; no user or lesson data needs changing.
INTERNATIONAL_SCHEDULING_ENABLED=false

# Template-based beta retention (cron/retentionMessages.js). Keep false until both templates are
# approved in Meta. false = no retention messages at all. The old plain-text retention engine
# (Day-30 report, upgrade nudges, READY-user comeback) is retired and never runs in either mode.
# Sends at 17:00 local (IST when international scheduling is off).
RETENTION_ENGINE_ENABLED=false
# Leave EMPTY until approved - an empty template is never sent (nothing is claimed either).
# lesson_waiting_reminder (Utility): {{1}} name, {{2}} pending lesson day
WHATSAPP_LESSON_WAITING_TEMPLATE=
# subscription_progress_update (Utility): {{1}} name, {{2}} lessons completed, {{3}} speaking practices, {{4}} plan end date
WHATSAPP_PROGRESS_UPDATE_TEMPLATE=
WHATSAPP_RETENTION_TEMPLATE_LANG=en_US

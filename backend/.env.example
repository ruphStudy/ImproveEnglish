PORT=3000
MONGO_URI=
OPENAI_API_KEY=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=

# Razorpay Payment Integration
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Public base URL of THIS backend (required in production - used as the Razorpay
# Payment Link callback_url for the WhatsApp UPGRADE flow; without it in prod,
# upgrade payment confirmations silently point at http://localhost:3001)
SERVER_URL=

# Redis Configuration (for Bull Queue)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
LESSON_WORKER_CONCURRENCY=15

# Admin/operational endpoint protection (required in production - see middleware/adminAuth.js)
# Send as header: x-admin-secret: <value>
ADMIN_SECRET=
